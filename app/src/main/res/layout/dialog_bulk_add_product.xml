<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nhập Nhanh Hàng Loạt"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Thêm 100+ sản phẩm từ file Excel hoặc dán nhanh"
                    android:textColor="@color/text_muted"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_close_bulk_add"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_gray"
                android:contentDescription="@string/cd_close"
                android:padding="10dp"
                android:src="@drawable/ic_close"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <!-- Mode Switcher -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_segmented_container"
            android:orientation="horizontal"
            android:padding="4dp">

            <TextView
                android:id="@+id/tab_mode_excel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_pill_white"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="📊 File Excel / CSV"
                android:textColor="@color/primary_blue"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tab_mode_quick_text"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="⚡ Nhập nhanh nhiều dòng"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Shared Defaults Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.5"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Danh mục mặc định"
                    android:textColor="@color/text_muted"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinner_bulk_default_category"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_card_subtle"
                    android:paddingHorizontal="10dp" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:hint="Kho mặc định">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_bulk_default_stock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="10" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- SECTION 1: EXCEL IMPORT -->
        <LinearLayout
            android:id="@+id/layout_excel_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_blue_tint"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hỗ trợ file Excel (.xlsx) &amp; CSV (.csv)"
                    android:textColor="@color/primary_blue"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Cột chuẩn: Tên sản phẩm | Giá bán | Tồn kho | Danh mục | Mã SKU | Mô tả. Có thể dùng tiêu đề tiếng Việt hoặc tiếng Anh."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_pick_excel_file"
                    style="@style/Widget.Material3.Button.UnelevatedButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1.2"
                    android:text="📂 Chọn file Excel"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary_blue"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_download_sample_excel"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="📥 Tải file mẫu"
                    android:textColor="@color/green_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/green_icon_bg"
                    app:cornerRadius="12dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_selected_excel_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chưa chọn file nào"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- SECTION 2: QUICK MULTI-LINE TEXT INPUT -->
        <LinearLayout
            android:id="@+id/layout_quick_text_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Mỗi dòng 1 SP: Tên | Giá | Kho | Danh mục"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_insert_quick_sample"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="📋 Mẫu nhanh"
                    android:textColor="@color/primary_blue"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_clear_quick_text"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_pill_gray"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="Xóa"
                    android:textColor="@color/text_secondary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="Dán từ Excel/Google Sheets hoặc gõ từng dòng...">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_bulk_quick_text"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:gravity="top|start"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:scrollbars="vertical"
                    android:textSize="12.5sp" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Parse Status & Preview -->
        <LinearLayout
            android:id="@+id/layout_parse_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card_subtle"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_bulk_summary_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/green_primary"
                android:textSize="12.5sp"
                android:textStyle="bold"
                tools:text="✅ Đã nhận diện 100 sản phẩm hợp lệ" />

            <TextView
                android:id="@+id/tv_bulk_error_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/amber_text"
                android:textSize="11.5sp"
                android:visibility="gone"
                tools:text="⚠️ Bỏ qua 1 dòng lỗi: Dòng 5 thiếu giá bán"
                tools:visibility="visible" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_bulk_preview"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="true"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_bulk_products"
            style="@style/Widget.Material3.Button.UnelevatedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:enabled="false"
            android:text="Chọn file hoặc nhập sản phẩm để lưu"
            android:textColor="@color/white"
            android:textSize="14.5sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_blue"
            app:cornerRadius="14dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:id="@+id/iv_tx_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_icon_square_green"
        android:contentDescription="@null"
        android:padding="10dp"
        android:src="@drawable/ic_cash"
        app:tint="@color/green_primary" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_tx_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Đơn #DH-9821 (COD)" />

        <TextView
            android:id="@+id/tv_tx_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/text_hint"
            android:textSize="12sp"
            tools:text="15/11/2026 - Thu bởi Shipper" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tx_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/green_primary"
        android:textSize="14.5sp"
        android:textStyle="bold"
        tools:text="+450.000đ" />

</LinearLayout>

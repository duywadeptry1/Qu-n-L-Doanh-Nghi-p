<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_subtle"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_vip_channel_symbol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_blue"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:textColor="@color/indigo_primary"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="🏢 B2B" />

        <TextView
            android:id="@+id/tv_vip_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="13.5sp"
            android:textStyle="bold"
            tools:text="Cty TNHH Minh Phát (A. Hoàng)" />

        <TextView
            android:id="@+id/tv_vip_tier_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_pill_amber"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/amber_text"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="👑 VIP Vàng" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_vip_frequency"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            tools:text="0901 234 567 • Tần suất: 4 đơn" />

        <TextView
            android:id="@+id/tv_vip_total_spent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/primary_blue"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="13.552.000đ" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_vip_benefits_line"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/green_primary"
        android:textSize="11.5sp"
        android:textStyle="bold"
        tools:text="✓ Quyền lợi: -15% SP Demo • -10.000đ ship (giữ sàn giá vốn ≥ 15.000đ)" />

</LinearLayout>

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/viendong?retryWrites=true&w=majority

# Server port
PORT=5000

# JWT Authentication Secrets (replace with strong random strings in production)
JWT_SECRET=replace-with-strong-access-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

# Set to true when Android app has migrated to JWT login to require tokens on /api/* as well
# Note: /api/v1/*, /api/users/*, /api/audit-logs, and /api/settings/* ALWAYS require JWT
REQUIRE_AUTH=false

# Comma-separated list of allowed Web Portal origins (or * for local dev)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional initial Admin account (used only when users collection is empty)
SEED_ADMIN_EMAIL=admin@viendong.vn
SEED_ADMIN_PASSWORD=Admin@123
